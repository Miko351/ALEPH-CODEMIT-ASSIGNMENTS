# Use your existing Day3 PostgreSQL connection when integrating with mini-watch.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/monitor_dashboard
# Optional monitoring receiver. Leave blank to keep only local request logs.
MONITOR_URL=http://127.0.0.1:5200/api/events
REQUEST_LOG_PATH=instance/requests.log
PORT=5100
